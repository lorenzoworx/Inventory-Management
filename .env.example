# Local development only. The project-local server listens on loopback.
DATABASE_URL=postgresql://ims@127.0.0.1:5433/ims
TEST_DATABASE_URL=postgresql://ims@127.0.0.1:5433/ims_test
COOKIE_SECURE=false
# Generate private local values with npm run setup:local. Do not commit .env.
SESSION_SECRET=
ADMIN_PASSWORD=
VIEWER_PASSWORD=
MANAGER_PASSWORD=
STAFF_PASSWORD=
# Deployment uses COOKIE_SECURE=true and an explicitly configured trusted proxy.
