# setup:deploy creates deploy/.env with random URL-safe hex secrets.
# Preserve this file and the volume across restarts; changing these values does not rotate existing DB passwords.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
SESSION_SECRET=
ADMIN_PASSWORD=
MANAGER_PASSWORD=
STAFF_PASSWORD=
# Intentionally public, read-only viewer credential for this demo only.
VIEWER_PASSWORD=Explore-Uba-Inventory
